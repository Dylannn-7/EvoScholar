{
  "name": "evoscholar",
  "version": "0.3.2",
  "private": true,
  "description": "EvoScholar: a self-evolving personal research workbench (literature, data and figures, manuscript checks) whose agent harness evolves in the loop",
  "license": "Apache-2.0",
  "author": "EvoScholar",
  "main": "apps/desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/harness",
    "packages/core",
    "apps/cli",
    "apps/server"
  ],
  "scripts": {
    "build": "tsc -b packages/harness packages/core apps/cli apps/server",
    "start": "node --no-warnings apps/server/dist/main.js",
    "chat": "node --no-warnings apps/cli/dist/main.js chat",
    "es": "node --no-warnings apps/cli/dist/main.js",
    "demo:evolution": "node scripts/demo-evolution.mjs",
    "setup:python": "node scripts/setup-python.mjs",
    "sandbox:build": "node scripts/build-sandbox.mjs",
    "test": "node --no-warnings --test --test-timeout=180000 packages/core/dist/*.test.js apps/server/dist/*.test.js apps/web/test/*.test.mjs apps/desktop/test/*.test.cjs",
    "demo": "node --no-warnings scripts/demo.mjs",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "app:smoke": "node scripts/app-smoke.mjs"
  },
  "dependencies": {
    "@evoscholar/core": "0.1.0",
    "@evoscholar/harness": "0.1.0",
    "@evoscholar/server": "0.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  }
}
